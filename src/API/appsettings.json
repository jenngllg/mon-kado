{
  "UrlImport": {
    "TimeoutSeconds": 20,
    "MaximumHtmlBytes": 2097152,
    "MaximumRedirects": 3,
    "PermitLimit": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost",
  "Jwt": {
    "Issuer": "MonKado.Api",
    "Audience": "MonKado.Frontend",
    "SigningKey": ""
  },
  "GoogleAuthentication": {
    "Enabled": false,
    "ClientId": "",
    "ClientSecret": "",
    "BackchannelTimeoutSeconds": 15,
    "FrontendOrigin": "http://localhost:5173",
    "DefaultReturnPath": "/login/google-return",
    "AllowedReturnPaths": [
      "/login/google-return"
    ]
  },
  "WishlistSharing": {
    "FrontendOrigin": "http://localhost:5173"
  },
  "GuestSessions": {
    "Lifetime": "180.00:00:00"
  },
  "GiftImages": {
    "StoragePath": ".local/gift-images"
  },
  "PersonalDataExports": {
    "StoragePath": ".local/personal-data-exports",
    "ArchiveLifetime": "1.00:00:00",
    "RequestWindow": "1.00:00:00",
    "MaximumRequests": 3,
    "MaximumAttempts": 5,
    "MaximumArchiveBytes": 1073741824,
    "AttemptTimeout": "00:10:00",
    "LeaseDuration": "00:02:00",
    "LeaseRenewalInterval": "00:00:30",
    "PollInterval": "00:00:10",
    "FailureInterval": "00:01:00",
    "CleanupBatchSize": 100,
    "TemporaryGracePeriod": "01:00:00",
    "RetryDelays": [
      "00:01:00",
      "00:05:00",
      "00:15:00",
      "01:00:00"
    ]
  },
  "WebSecurity": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  }
}
