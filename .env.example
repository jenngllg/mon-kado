# Local defaults. Replace API_HOST with the real API subdomain on the VPS.
API_HOST=http://localhost
HTTP_PORT=8080
HTTPS_PORT=8443
FRONTEND_ORIGIN=http://localhost:5173
API_ALLOWED_HOST=localhost
EDGE_NETWORK_CIDR=172.30.0.0/24

POSTGRES_DB=mon_kado
POSTGRES_USER=mon_kado
POSTGRES_PASSWORD=replace-with-a-long-hexadecimal-password
JWT_SIGNING_KEY=replace-with-a-base64-encoded-256-bit-signing-key

# Google sign-in uses a Web application OAuth client that is distinct from the Gmail Desktop client below.
# Keep it disabled until the matching HTTPS callback URI is registered in Google Cloud.
GOOGLE_AUTHENTICATION_ENABLED=false
GOOGLE_AUTHENTICATION_CLIENT_ID=
GOOGLE_AUTHENTICATION_CLIENT_SECRET=
GOOGLE_AUTHENTICATION_BACKCHANNEL_TIMEOUT_SECONDS=15

IMAGE_TAG=local

# Gmail delivery is disabled by compose.local.yaml. Production must set Gmail and all OAuth values.
AUTHENTICATION_EMAIL_PROVIDER=Disabled
AUTHENTICATION_EMAIL_PROCESSED_RETENTION_DAYS=30
AUTHENTICATION_EMAIL_DELIVERY_BATCH_SIZE=20
AUTHENTICATION_EMAIL_DELIVERY_LEASE_DURATION=00:02:00
AUTHENTICATION_EMAIL_POLL_INTERVAL=00:00:10
AUTHENTICATION_EMAIL_FAILURE_RETRY_INTERVAL=00:01:00
AUTHENTICATION_EMAIL_MAXIMUM_DELIVERY_ATTEMPTS=10
AUTHENTICATION_EMAIL_FIRST_RETRY_DELAY=00:01:00
AUTHENTICATION_EMAIL_SECOND_RETRY_DELAY=00:05:00
AUTHENTICATION_EMAIL_THIRD_RETRY_DELAY=00:15:00
AUTHENTICATION_EMAIL_FOURTH_RETRY_DELAY=01:00:00
AUTHENTICATION_EMAIL_SUBSEQUENT_RETRY_DELAY=06:00:00
AUTHENTICATION_EMAIL_SLOW_RETRY_DELAY=06:00:00
AUTHENTICATION_EMAIL_MAXIMUM_RETRY_DELAY=1.00:00:00
AUTHENTICATION_CLEANUP_BATCH_SIZE=500
AUTHENTICATION_CLEANUP_INTERVAL=1.00:00:00
AUTHENTICATION_CLEANUP_FAILURE_RETRY_INTERVAL=00:15:00
GMAIL_SENDER_ADDRESS=monkado.app@gmail.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REQUEST_TIMEOUT=00:00:15
