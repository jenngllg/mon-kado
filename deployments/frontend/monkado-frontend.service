[Unit]
Description=Install an explicitly approved static MonKado frontend
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0022
ExecStart=/usr/bin/python3 /opt/monkado/src/Operations.Frontend/frontend_cli.py deploy
TimeoutStartSec=10min
Nice=15
CPUQuota=25%
MemoryMax=192M
MemorySwapMax=0
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/monkado-frontend /var/lib/monkado-deployment

