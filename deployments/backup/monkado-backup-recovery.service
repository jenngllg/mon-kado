[Unit]
Description=Recover an interrupted MonKado backup maintenance window
Requires=docker.service
After=docker.service
Before=monkado-deploy.service

[Service]
Type=oneshot
User=root
UMask=0077
Environment=PYTHONPATH=/opt/monkado-backup
ExecStart=/usr/bin/python3 -m monkado_backup.cli recover
TimeoutStartSec=5min

[Install]
WantedBy=multi-user.target
