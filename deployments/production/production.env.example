# Copy to /etc/monkado/production.env, owned by root, mode 0600.
# This is Compose dotenv syntax, NOT a shell script. Never source this file.
API_HOST=api.monkado.fr
API_ALLOWED_HOST=api.monkado.fr
FRONTEND_ORIGIN=https://www.monkado.fr
POSTGRES_DB=mon_kado
POSTGRES_USER=mon_kado
# Generate independently with openssl rand -hex 32 and openssl rand -base64 32.
POSTGRES_PASSWORD=
JWT_SIGNING_KEY=
GOOGLE_AUTHENTICATION_ENABLED=false
AUTHENTICATION_EMAIL_PROVIDER=Gmail
GMAIL_SENDER_ADDRESS=monkado.app@gmail.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Keep connection pools within the small PostgreSQL connection budget.
# Other options retain the defaults from compose.yaml.
