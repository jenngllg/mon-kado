# Copy to /etc/monkado/production.env, owned by root, mode 0600.
# systemd EnvironmentFile syntax, NOT a shell script. Never source or print it.
# Fill DATABASE_URL privately for the native local PostgreSQL role/database.
# The deployment/backup tools inspect mon_kado only through the postgres peer socket.
DATABASE_URL=
# Generate each independent key with openssl rand -base64 32. Keep both stable across releases.
JWT_SIGNING_KEY=
DATA_ENCRYPTION_KEY=
APP_ENV=production
HTTP_ADDRESS=127.0.0.1:7000
FRONTEND_ORIGIN=https://www.monkado.fr
ALLOWED_ORIGINS=https://www.monkado.fr
ALLOWED_HOSTS=api.monkado.fr
PUBLIC_API_ORIGIN=https://api.monkado.fr
TRUSTED_PROXIES=127.0.0.1/32,::1/128
IMAGE_PATH=/var/lib/monkado/gift-images
EXPORT_PATH=/var/lib/monkado/personal-data-exports
GENERAL_RATE_LIMIT_PERMIT_LIMIT=300
GENERAL_RATE_LIMIT_WINDOW_SECONDS=60
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_PROVIDER=Gmail
GMAIL_SENDER_ADDRESS=monkado.app@gmail.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
WORKER_INTERVAL=10s
WISH_IMPORT_TIMEOUT=20s
WISH_IMPORT_MAXIMUM_HTML_BYTES=2097152
WISH_IMPORT_MAXIMUM_REDIRECTS=3
WISH_IMPORT_PERMIT_LIMIT=10
PROVIDER_HTTP_TIMEOUT=15s
PROVIDER_FAILURE_THRESHOLD=5
PROVIDER_BREAK_DURATION=30s
OUTBOX_MAXIMUM_ATTEMPTS=10
JOB_BATCH_SIZE=100
EXPORT_BATCH_SIZE=5
JOB_LEASE_DURATION=2m
JOB_RENEWAL_INTERVAL=30s
EXPORT_TIMEOUT=10m
EXPORT_LIFETIME=24h
EXPORT_MAXIMUM_BYTES=1073741824
EXPORT_MAXIMUM_ATTEMPTS=5
OUTBOX_FIRST_RETRY_DELAY=1m
OUTBOX_MAXIMUM_RETRY_DELAY=24h
PENDING_FILE_GRACE_PERIOD=1h
WISH_IMPORT_CATALOG_ENABLED=false
WISH_IMPORT_CATALOG_INDEX_KEY=
OBSERVABILITY_ENABLED=true
OBSERVABILITY_DIRECTORY=/var/lib/monkado-observability
OBSERVABILITY_INTERVAL=30s
# APP_VERSION comes from root-owned active.env, generated from the approved manifest.
